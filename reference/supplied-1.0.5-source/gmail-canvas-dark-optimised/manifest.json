{
  "manifest_version": 3,
  "name": "Gmail Canvas Dark (Optimised)",
  "version": "1.0.5",
  "description": "Community performance-optimised fork of Gmail Canvas Dark 1.0.4.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "css": [
        "content/theme.css"
      ],
      "js": [
        "content/theme.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "gmail-canvas-dark-optimised@example.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
