{
  "manifest_version": 3,
  "name": "Gmail Canvas Dark",
  "version": "1.0.4",
  "description": "Darkens Gmail message, settings and chat surfaces while leaving your Gmail theme/background image untouched.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "css": [
        "content/theme.css"
      ],
      "js": [
        "content/theme.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{66152c13-1c07-4f37-b651-d7948fd9a5e0}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}